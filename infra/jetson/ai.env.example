# Existing AI runtime installed on the Jetson. This file must not contain
# backend credentials: MQTT and REST delivery belong to aiot-robot.service.
AIOT_AI_ROOT=/home/e103/yolo-pipeline
AIOT_AI_PYTHON=/home/e103/yolo-pipeline/venv/bin/python
AIOT_AI_PIPELINE_MAIN=/home/e103/yolo-pipeline/yolo_pipeline/main.py
AIOT_IOT_CURRENT=/opt/aiot/iot/current
ROS_SETUP_FILE=/opt/ros/humble/setup.bash
ROS_LOCALHOST_ONLY=1
ROS_DOMAIN_ID=0

AIOT_AI_STATUS_TOPIC=/ai/status
AIOT_AI_READY_FILE=/run/aiot/ai-ready.json
AIOT_AI_READY_TIMEOUT_SEC=90
AIOT_AI_STATUS_MAX_AGE_SEC=5
AIOT_AI_EVIDENCE_DIR=/var/lib/aiot/evidence
AIOT_AI_PIPELINE_EXTRA_ARGS=--no-show

# Both engines were deserialized successfully on TensorRT 10.3. Preflight
# rejects startup if either exact file is absent or incompatible.
AIOT_AI_REQUIRED_ENGINE_PATHS=/home/e103/yolo-pipeline/yolo_pipeline/models/yolo26_b2_416_fp16.engine:/home/e103/yolo-pipeline/yolo_pipeline/models/plate_rec_fp16.engine
AIOT_AI_VALIDATE_TRT_ENGINES=true

# The deployed engine has batch size 2, but its track_frame path pads the unused
# slot. Only the stable Logitech Brio 100 alias opens a physical camera handle.
AIOT_AI_SINGLE_CAMERA=true
AIOT_AI_REQUIRE_DUAL_CAMERAS=false
AIOT_AI_CAMERA_DEVICE=/dev/roki_camera_right
AIOT_AI_CAMERA_LEFT_DEVICE=
AIOT_AI_CAMERA_RIGHT_DEVICE=
AIOT_AI_CAPTURE_WIDTH=640
AIOT_AI_CAPTURE_HEIGHT=480
AIOT_AI_CAPTURE_FPS=30
AIOT_AI_CAPTURE_FOURCC=MJPG
AIOT_AI_CAPTURE_BUFFER_SIZE=1

# Loopback-only annotated dual-camera preview. Publish it outside the Jetson
# only through the authenticated HTTPS relay described in the operations guide.
AIOT_AI_MJPEG_ENABLED=true
AIOT_AI_MJPEG_BIND=127.0.0.1
AIOT_AI_MJPEG_PORT=8090
AIOT_AI_MJPEG_QUALITY=70
AIOT_AI_MJPEG_MAX_FPS=5

# Deprecated compatibility names.
AIOT_AI_CAMERA_FRONT_DEVICE=
AIOT_AI_CAMERA_REAR_DEVICE=

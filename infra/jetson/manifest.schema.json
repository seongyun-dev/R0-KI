{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://i15e103.p.ssafy.io/jetson/iot-manifest.schema.json",
  "title": "AIoT Jetson IoT stable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "release",
    "iot_commit",
    "required_ai_contract_version",
    "jetpack",
    "architecture",
    "artifact_url",
    "artifact_size_bytes",
    "sha256",
    "published_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "component": {
      "const": "iot"
    },
    "release": {
      "type": "string",
      "pattern": "^iot-v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "iot_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "required_ai_contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "jetpack": {
      "const": "6.2"
    },
    "architecture": {
      "const": "aarch64"
    },
    "artifact_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "artifact_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

[Unit]
Description=AIoT robot runtime
Wants=aiot-ai.service
After=aiot-update.service aiot-ai.service
Requires=aiot-update.service
ConditionFileIsExecutable=/opt/aiot/iot/current/robot/scripts/run.sh

[Service]
Type=simple
User=aiot
Group=aiot
SupplementaryGroups=dialout video render
WorkingDirectory=/opt/aiot/iot/current
EnvironmentFile=-/opt/aiot/secrets/robot.env
Environment=ROS_LOCALHOST_ONLY=1
Environment=ROS_DOMAIN_ID=0
ExecStart=/opt/aiot/iot/current/robot/scripts/run.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target

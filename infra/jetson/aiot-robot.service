[Unit]
Description=AIoT robot runtime
After=aiot-update.service
Requires=aiot-update.service
ConditionFileIsExecutable=/opt/aiot/current/robot/scripts/run.sh

[Service]
Type=simple
User=aiot
Group=aiot
SupplementaryGroups=dialout video
WorkingDirectory=/opt/aiot/current
EnvironmentFile=-/opt/aiot/secrets/robot.env
ExecStart=/opt/aiot/current/robot/scripts/run.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target

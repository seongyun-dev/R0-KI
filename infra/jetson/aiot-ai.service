[Unit]
Description=AIoT Jetson AI runtime
Wants=network-online.target aiot-update.service
After=network-online.target
ConditionPathExists=/opt/aiot/iot/current/robot/src/aiot_robot/ai_runtime.py
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=e103
SupplementaryGroups=aiot video render
WorkingDirectory=/home/e103/yolo-pipeline
Environment=ROS_LOCALHOST_ONLY=1
Environment=ROS_DOMAIN_ID=0
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/aiot/secrets/ai.env
RuntimeDirectory=aiot
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0007
ExecStartPre=/opt/aiot/bin/aiot-ai-preflight
ExecStart=/opt/aiot/bin/aiot-ai-run
ExecStartPost=/opt/aiot/bin/aiot-ai-wait-ready
ExecStopPost=/usr/bin/rm -f /run/aiot/ai-ready.json
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target

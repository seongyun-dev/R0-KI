# Source overlays already built on the project Jetson.
AIOT_ROS_MODE=patrol
ROS_SETUP_FILE=/opt/ros/humble/setup.bash
AIOT_YDLIDAR_SETUP_FILE=/home/e103/ydlidar_ws/install/setup.bash
AIOT_RF2O_SETUP_FILE=/home/e103/rf2o_ws/install/setup.bash
ROKI_LIDAR_DEVICE=/dev/roki_lidar
AIOT_NAV2_RENDERED_CONFIG=/run/aiot/nav2.params.yaml

# Field measurements. Keep blank until physically measured and reviewed.
ROKI_LIDAR_X_M=
ROKI_LIDAR_Y_M=
ROKI_LIDAR_Z_M=
ROKI_LIDAR_YAW_RAD=
ROKI_WHEELBASE_M=
ROKI_MAXIMUM_ROAD_WHEEL_ANGLE_DEG=
ROKI_ROBOT_RADIUS_M=

# Persistent field artifacts. The repository and OTA archive must not contain
# the real map or route.local.yaml.
ROKI_MAP_YAML=/var/lib/aiot/config/map.yaml
ROKI_NAV2_BT_XML=/opt/aiot/iot/current/robot/config/ros/nav2_fixed_path.xml
ROKI_NAV2_DESIRED_LINEAR_SPEED_MPS=0.20
ROKI_MAXIMUM_LINEAR_SPEED_MPS=0.40

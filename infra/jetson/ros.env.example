# Source overlays already built on the project Jetson.
# Initial/fallback mode. After a mapping upload succeeds,
# /var/lib/aiot/config/current-map.env overrides this with patrol and the exact
# Backend map identity selected by the Robot runtime.
AIOT_ROS_MODE=patrol
ROS_SETUP_FILE=/opt/ros/humble/setup.bash
AIOT_YDLIDAR_SETUP_FILE=/home/e103/ydlidar_ws/install/setup.bash
AIOT_RF2O_SETUP_FILE=/home/e103/rf2o_ws/install/setup.bash
ROKI_LIDAR_DEVICE=/dev/roki_lidar
AIOT_NAV2_RENDERED_CONFIG=/run/aiot/nav2.params.yaml

# Field measurements. Keep blank until physically measured and reviewed.
ROKI_LIDAR_X_M=
ROKI_LIDAR_Y_M=
ROKI_LIDAR_Z_M=
ROKI_LIDAR_YAW_RAD=
ROKI_WHEELBASE_M=
ROKI_MAXIMUM_ROAD_WHEEL_ANGLE_DEG=
ROKI_ROBOT_RADIUS_M=

# Fixed, physically marked demo dock pose in the saved occupancy map frame.
# X/Y are metres and yaw is radians.  Patrol preflight rejects blank values.
ROKI_INITIAL_POSE_X_M=
ROKI_INITIAL_POSE_Y_M=
ROKI_INITIAL_POSE_YAW_RAD=

# Persistent field artifacts. The repository and OTA archive must not contain
# the real map or route.local.yaml. These are initial/fallback values; an
# accepted newly mapped bundle is selected through current-map.env.
ROKI_MAP_YAML=/var/lib/aiot/config/map.yaml
# These four values bind the route and exact map files selected for the demo.
# Generate hashes only after the final map and route have been copied in place.
ROKI_MAP_ID=
ROKI_MAP_VERSION=
ROKI_MAP_SHA256=
ROKI_ROUTE_SHA256=
ROKI_MAP_MIN_KNOWN_COVERAGE_RATIO=0.10
ROKI_MAP_MIN_FREE_COVERAGE_RATIO=0.10
ROKI_NAV2_BT_XML=/opt/aiot/iot/current/robot/config/ros/nav2_fixed_path.xml
ROKI_NAV2_DESIRED_LINEAR_SPEED_MPS=0.20
ROKI_MAXIMUM_LINEAR_SPEED_MPS=0.40
ROKI_NAV2_XY_GOAL_TOLERANCE_M=0.20

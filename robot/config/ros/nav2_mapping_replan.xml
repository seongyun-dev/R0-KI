<!--
  Exploration behaviour tree for the Ackermann chassis.

  Frontier goals sit at the edge of a map that is still growing, so unlike the
  fixed patrol route a goal can become stale or briefly unreachable. This tree
  therefore replans instead of following one path to the end.

  It deliberately contains no Spin or BackUp: this chassis cannot rotate in place
  and reverse is not enabled, so those behaviours would either fail or move the
  robot in a way the operator did not expect. It also deliberately avoids
  ClearEntireCostmap: clearing a live SLAM costmap can temporarily erase the
  evidence that made the old path unsafe. One bounded wait/replan is enough;
  persistent failure is returned to the explorer as a frontier failure.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1" name="MappingNavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="0.5">
          <ComputePathToPose goal="{goal}" path="{path}"
                             planner_id="MappingGridBased"/>
        </RateController>
        <FollowPath path="{path}" controller_id="MappingFollowPath"
                    goal_checker_id="general_goal_checker"/>
      </PipelineSequence>
      <Wait wait_duration="1.0"/>
    </RecoveryNode>
  </BehaviorTree>
</root>

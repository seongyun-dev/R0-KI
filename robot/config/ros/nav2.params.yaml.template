# 위치추정 서버(amcl)와 map_server 는 여기 없다.
# slam_toolbox 의 map_and_localization 노드가 매핑과 위치추정 두 역할을 모두
# 맡고 /map 과 map->odom 을 두 운행 모두에서 발행한다. upstream 은 그 위치추정
# 모드를 AMCL 대체로 명시한다. 전환은 프로세스 교체가 아니라
# slam_toolbox/set_localization_mode 서비스 호출이며,
# roki-iot/integration/localization_mode.py 가 수행한다.

bt_navigator:
  ros__parameters:
    use_sim_time: false
    global_frame: map
    robot_base_frame: base_link
    odom_topic: /odom
    bt_loop_duration: 10
    default_server_timeout: 20
    default_nav_to_pose_bt_xml: $NAV2_BT_XML
    # Nav2 initializes both navigator types even though the Robot sends only
    # NavigateToPose goals. Use a no-recovery through-poses tree as well so
    # activation does not depend on Spin/BackUp actions that an Ackermann
    # chassis cannot safely execute in place.
    default_nav_through_poses_bt_xml: $NAV2_THROUGH_POSES_BT_XML
    plugin_lib_names:
      - nav2_compute_path_to_pose_action_bt_node
      - nav2_compute_path_through_poses_action_bt_node
      - nav2_smooth_path_action_bt_node
      - nav2_follow_path_action_bt_node
      - nav2_spin_action_bt_node
      - nav2_wait_action_bt_node
      - nav2_assisted_teleop_action_bt_node
      - nav2_back_up_action_bt_node
      - nav2_drive_on_heading_bt_node
      - nav2_clear_costmap_service_bt_node
      - nav2_is_stuck_condition_bt_node
      - nav2_goal_reached_condition_bt_node
      - nav2_goal_updated_condition_bt_node
      - nav2_globally_updated_goal_condition_bt_node
      - nav2_is_path_valid_condition_bt_node
      - nav2_initial_pose_received_condition_bt_node
      - nav2_reinitialize_global_localization_service_bt_node
      - nav2_rate_controller_bt_node
      - nav2_distance_controller_bt_node
      - nav2_speed_controller_bt_node
      - nav2_truncate_path_action_bt_node
      - nav2_truncate_path_local_action_bt_node
      - nav2_goal_updater_node_bt_node
      - nav2_recovery_node_bt_node
      - nav2_pipeline_sequence_bt_node
      - nav2_round_robin_node_bt_node
      - nav2_transform_available_condition_bt_node
      - nav2_time_expired_condition_bt_node
      - nav2_path_expiring_timer_condition
      - nav2_distance_traveled_condition_bt_node
      - nav2_single_trigger_bt_node
      - nav2_goal_updated_controller_bt_node
      - nav2_is_battery_low_condition_bt_node
      - nav2_navigate_through_poses_action_bt_node
      - nav2_navigate_to_pose_action_bt_node
      - nav2_remove_passed_goals_action_bt_node
      - nav2_planner_selector_bt_node
      - nav2_controller_selector_bt_node
      - nav2_goal_checker_selector_bt_node
      - nav2_controller_cancel_bt_node
      - nav2_path_longer_on_approach_bt_node
      - nav2_wait_cancel_bt_node
      - nav2_spin_cancel_bt_node
      - nav2_back_up_cancel_bt_node
      - nav2_assisted_teleop_cancel_bt_node
      - nav2_drive_on_heading_cancel_bt_node
      - nav2_is_battery_charging_condition_bt_node

bt_navigator_navigate_to_pose_rclcpp_node:
  ros__parameters:
    use_sim_time: false

controller_server:
  ros__parameters:
    use_sim_time: false
    controller_frequency: 20.0
    min_x_velocity_threshold: 0.001
    min_y_velocity_threshold: 0.5
    min_theta_velocity_threshold: 0.001
    failure_tolerance: 0.0
    progress_checker_plugin: progress_checker
    goal_checker_plugins: [general_goal_checker]
    controller_plugins: [FollowPath]
    progress_checker:
      plugin: nav2_controller::SimpleProgressChecker
      required_movement_radius: 0.10
      movement_time_allowance: 15.0
    general_goal_checker:
      stateful: true
      plugin: nav2_controller::SimpleGoalChecker
      xy_goal_tolerance: $XY_GOAL_TOLERANCE_M
      yaw_goal_tolerance: 0.35
    FollowPath:
      plugin: nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController
      desired_linear_vel: $DESIRED_LINEAR_SPEED_MPS
      lookahead_dist: 0.45
      min_lookahead_dist: 0.30
      max_lookahead_dist: 0.65
      lookahead_time: 1.5
      transform_tolerance: 0.20
      use_velocity_scaled_lookahead_dist: true
      min_approach_linear_velocity: 0.05
      approach_velocity_scaling_dist: 0.60
      use_collision_detection: true
      max_allowed_time_to_collision_up_to_carrot: 1.0
      use_regulated_linear_velocity_scaling: true
      use_cost_regulated_linear_velocity_scaling: false
      regulated_linear_scaling_min_radius: $MINIMUM_TURNING_RADIUS_M
      regulated_linear_scaling_min_speed: 0.10
      use_rotate_to_heading: false
      use_interpolation: true

local_costmap:
  local_costmap:
    ros__parameters:
      update_frequency: 5.0
      publish_frequency: 2.0
      global_frame: odom
      robot_base_frame: base_link
      use_sim_time: false
      rolling_window: true
      width: 3
      height: 3
      resolution: 0.05
      # Measured body: 0.35 m long, 0.25 m wide, centred on base_link (the LiDAR
      # sits directly above it). robot_radius describes a *circular* robot, and
      # Nav2 then uses that single number as BOTH the circumscribed and the
      # inscribed radius. For this rectangle the circumscribed radius really is
      # sqrt(0.175^2 + 0.125^2) = 0.215 m -- which is what the 0.23 m measurement
      # captured -- but the inscribed radius is only the half-width, 0.125 m.
      # Declaring a circle therefore inflated every obstacle by 0.23 m instead of
      # 0.125 m and marked the robot's own cell lethal whenever it came within
      # 0.23 m of a wall: the "Starting point in lethal space" that killed plans.
      # A polygon also switches the collision check from a centre-cost test to a
      # real footprint test, so the clearance is not bought by weakening safety.
      # The chassis is a physical fact, not a mode preference, so patrol and
      # mapping share it. Nav2 takes the lethal inscribed radius from this
      # polygon (0.125 m here). inflation_radius below is only the cost skirt
      # outside it and no longer derives from the retired robot_radius.
      footprint: "[[0.175, 0.125], [0.175, -0.125], [-0.175, -0.125], [-0.175, 0.125]]"
      plugins: [obstacle_layer, inflation_layer]
      obstacle_layer:
        plugin: nav2_costmap_2d::ObstacleLayer
        enabled: true
        observation_sources: scan
        scan:
          topic: /scan
          max_obstacle_height: 2.0
          clearing: true
          marking: true
          data_type: LaserScan
          raytrace_max_range: 3.0
          # 근거리 필터는 드라이버의 range_min(0.25) 한 곳에서만 한다.
          # 여기도 0.25 로 올려봤지만 이미 드라이버가 그 아래를 안 내보내므로
          # 현재는 아무 일도 하지 않고, 드라이버 설정이 되돌려지는 날에는
          # 진짜 근거리 장애물까지 표시하지 않게 된다. 걸러내는 곳이 둘이면
          # 어느 쪽이 동작 중인지 알 수 없어진다.
          raytrace_min_range: 0.05
          obstacle_max_range: 2.5
          obstacle_min_range: 0.05
      inflation_layer:
        plugin: nav2_costmap_2d::InflationLayer
        cost_scaling_factor: 3.0
        inflation_radius: $INFLATION_RADIUS_M
      always_send_full_costmap: true

global_costmap:
  global_costmap:
    ros__parameters:
      update_frequency: 1.0
      publish_frequency: 1.0
      global_frame: map
      robot_base_frame: base_link
      use_sim_time: false
      # Same measured rectangle as the local costmap above; see the derivation
      # there. Both costmaps must agree on the body or the planner and the
      # controller disagree about what fits.
      footprint: "[[0.175, 0.125], [0.175, -0.125], [-0.175, -0.125], [-0.175, 0.125]]"
      resolution: 0.05
      # The stored map is localization evidence, not a demo-route gate.  Plan
      # across stale walls/unknown cells, while the local LiDAR costmap and
      # Robot obstacle interlock still stop motion for real obstacles.
      rolling_window: true
      # Nav2 declares rolling-window width/height as integer parameters on
      # Humble. Decimal YAML scalars make planner_server abort during startup.
      width: 20
      height: 20
      track_unknown_space: false
      plugins: [inflation_layer]
      inflation_layer:
        plugin: nav2_costmap_2d::InflationLayer
        cost_scaling_factor: 3.0
        inflation_radius: $INFLATION_RADIUS_M
      always_send_full_costmap: true

map_saver:
  ros__parameters:
    use_sim_time: false
    save_map_timeout: 5.0
    free_thresh_default: 0.25
    occupied_thresh_default: 0.65
    map_subscribe_transient_local: true

planner_server:
  ros__parameters:
    expected_planner_frequency: 1.0
    use_sim_time: false
    planner_plugins: [GridBased]
    GridBased:
      plugin: nav2_smac_planner/SmacPlannerHybrid
      tolerance: 0.20
      downsample_costmap: false
      downsampling_factor: 1
      allow_unknown: true
      max_iterations: 1000000
      max_on_approach_iterations: 1000
      max_planning_time: 3.5
      motion_model_for_search: DUBIN
      angle_quantization_bins: 64
      analytic_expansion_ratio: 3.5
      analytic_expansion_max_length: $ANALYTIC_EXPANSION_MAX_LENGTH_M
      minimum_turning_radius: $MINIMUM_TURNING_RADIUS_M
      reverse_penalty: 2.1
      change_penalty: 0.0
      non_straight_penalty: 1.2
      cost_penalty: 2.0
      retrospective_penalty: 0.025
      lookup_table_size: 20.0
      cache_obstacle_heuristic: true
      smooth_path: true
      smoother:
        max_iterations: 1000
        w_smooth: 0.3
        w_data: 0.2
        tolerance: 1.0e-10
        do_refinement: true

behavior_server:
  ros__parameters:
    costmap_topic: local_costmap/costmap_raw
    footprint_topic: local_costmap/published_footprint
    cycle_frequency: 10.0
    behavior_plugins: [wait]
    wait:
      plugin: nav2_behaviors/Wait
    global_frame: odom
    robot_base_frame: base_link
    transform_tolerance: 0.1
    use_sim_time: false

waypoint_follower:
  ros__parameters:
    use_sim_time: false
    loop_rate: 20
    stop_on_failure: true
    waypoint_task_executor_plugin: wait_at_waypoint
    wait_at_waypoint:
      plugin: nav2_waypoint_follower::WaitAtWaypoint
      enabled: true
      waypoint_pause_duration: 0

velocity_smoother:
  ros__parameters:
    use_sim_time: false
    smoothing_frequency: 20.0
    scale_velocities: false
    feedback: OPEN_LOOP
    max_velocity: [$MAXIMUM_LINEAR_SPEED_MPS, 0.0, 1.0]
    min_velocity: [0.0, 0.0, -1.0]
    max_accel: [0.5, 0.0, 1.0]
    max_decel: [-0.8, 0.0, -1.5]
    odom_topic: /odom
    odom_duration: 0.2
    deadband_velocity: [0.0, 0.0, 0.0]
    velocity_timeout: 0.5

# ROS 2 is local to the Jetson. Keep DDS traffic off the apartment network.
ROS_LOCALHOST_ONLY=1
ROS_DOMAIN_ID=0

AIOT_AI_CONTROL_TOPIC=/ai/control
AIOT_AI_STATUS_TOPIC=/ai/status
AIOT_AI_DETECTIONS_TOPIC=/ai/detections
AIOT_AI_STATUS_TIMEOUT_SEC=5

# install.sh creates this directory for the aiot service account.
AIOT_EVENT_OUTBOX_DIR=/var/lib/aiot/outbox

# Filled by the future backend/MQTT mission adapter.
AIOT_ROBOT_ID=
AIOT_BACKEND_BASE_URL=
AIOT_BACKEND_ACCESS_TOKEN=
AIOT_BACKEND_TIMEOUT_SEC=10

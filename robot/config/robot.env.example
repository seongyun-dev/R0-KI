# Copy to /opt/aiot/secrets/robot.env as root. Never commit real credentials.
SCHEMA_VERSION=1
ROBOT_KEY=replace-with-backend-robot-key

MQTT_HOST=i15e103.p.ssafy.io
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=

POSE_PUBLISH_INTERVAL_SECONDS=1
STATUS_PUBLISH_INTERVAL_SECONDS=5

ROS_LOCALHOST_ONLY=1
ROS_DOMAIN_ID=0
AIOT_AI_CONTROL_TOPIC=/ai/control
AIOT_AI_STATUS_TOPIC=/ai/status
AIOT_AI_DETECTIONS_TOPIC=/ai/detections
AIOT_AI_STATUS_TIMEOUT_SEC=5
AIOT_AI_CONTROL_APPLY_TIMEOUT_SEC=3
AIOT_MIN_DETECTION_CONFIDENCE=0.5
AIOT_AI_REQUIRED_FOR_PATROL=true
AIOT_LIDAR_REQUIRED_FOR_PATROL=true
OBSTACLE_CLEAR_HOLD_SECONDS=1.0

AIOT_EVENT_OUTBOX_DIR=/var/lib/aiot/outbox
# Robot is the only Backend REST event owner. The AI process publishes ROS only.
AIOT_EVENT_DELIVERY_OWNER=robot
AIOT_DELETE_DELIVERED_EVIDENCE=true
AIOT_COMMAND_CACHE_FILE=/var/lib/aiot/state/command-cache.json
AIOT_PATROL_DEPLOY_LOCK_FILE=/var/lib/aiot/state/patrol-deploy.lock
AIOT_BACKEND_BASE_URL=https://i15e103.p.ssafy.io
AIOT_BACKEND_ACCESS_TOKEN=
AIOT_BACKEND_TOKEN_FILE=/var/lib/aiot/secrets/robot-service-token
AIOT_BACKEND_TIMEOUT_SEC=10

# Simple single-BRIO vehicle localization. Wheel/SLAM pose locates the robot;
# the LiDAR front sector supplies distance to the detected vehicle.
AIOT_VEHICLE_CAMERA_YAW_DEG=0
# Raw LaserScan angles are in laser_frame, not base_link. Keep these at 0 for
# a forward-facing LiDAR. A sensor mounted 90 degrees to the robot's right
# while base_link->laser_frame yaw is -90 degrees uses +90 here.
AIOT_LIDAR_FORWARD_CENTER_ANGLE_DEG=0
AIOT_VEHICLE_LIDAR_CENTER_ANGLE_DEG=0
AIOT_VEHICLE_FRONT_HALF_ANGLE_DEG=8
AIOT_VEHICLE_MAX_RANGE_M=8
AIOT_VEHICLE_NEAREST_SAMPLES=5
AIOT_VEHICLE_RANGE_MAX_AGE_SEC=1

# Manual SLAM mapping. The gamepad is opened only after Backend sends
# START_MAPPING, so the runtime can boot while the USB receiver is absent.
AIOT_MAPPING_GAMEPAD_ENABLED=true
AIOT_MAPPING_OUTPUT_DIR=/var/lib/aiot/maps
AIOT_MAPPING_EXPORT_TIMEOUT_SEC=30
AIOT_MAPPING_SERIALIZE_POSE_GRAPH=true
AIOT_MAPPING_UPLOAD_RETRY_INITIAL_SEC=2
AIOT_MAPPING_UPLOAD_RETRY_MAX_SEC=30
# Backend acceptance promotes the exact YAML/PGM bundle here. 활성화는 더 이상
# 서비스를 재시작하지 않는다 -- slam_toolbox 를 위치추정 모드로 바꾸는 서비스
# 호출로 전환하므로, 여기 기록되는 것은 활성 지도의 신원뿐이다.
AIOT_ACTIVE_MAP_DIR=/var/lib/aiot/maps/active
AIOT_ACTIVE_MAP_ENV_FILE=/var/lib/aiot/config/current-map.env
ROKI_MAPPING_GAMEPAD_DEVICE=/dev/input/js0
ROKI_MAPPING_GAMEPAD_STEERING_AXIS=0
ROKI_MAPPING_GAMEPAD_THROTTLE_AXIS=1
ROKI_MAPPING_GAMEPAD_DEADMAN_BUTTON=4
# 현장 RC식 조작은 false. true이면 LB를 누른 동안만 움직인다.
ROKI_MAPPING_GAMEPAD_DEADMAN_REQUIRED=true
ROKI_MAPPING_GAMEPAD_STOP_BUTTON=1
ROKI_MAPPING_GAMEPAD_FINISH_BUTTON_A=6
ROKI_MAPPING_GAMEPAD_FINISH_BUTTON_B=7
ROKI_MAPPING_GAMEPAD_DEADZONE=0.35
ROKI_MAPPING_FINISH_HOLD_SEC=2.0
ROKI_MAPPING_GAMEPAD_LOOP_SEC=0.05
ROKI_MAPPING_GAMEPAD_RECONNECT_SEC=1.0
# Linux js emits change events, not periodic keepalives. Zero allows the held
# deadman/stick state to be refreshed continuously. Release, STOP, USB removal,
# process failure and the ESP32 watchdog remain stop paths. Set a positive value
# only when a receiver is known to emit periodic events while held.
ROKI_MAPPING_GAMEPAD_INPUT_LEASE_SEC=0
ROKI_MAPPING_FORWARD_PWM=45
ROKI_MAPPING_REVERSE_PWM=45
ROKI_MAPPING_DRIVE_PULSE_SEC=0.2
ROKI_MAPPING_STEERING_CENTER_DEG=80
ROKI_MAPPING_STEERING_MIN_DEG=60
ROKI_MAPPING_STEERING_MAX_DEG=100
ROKI_MAPPING_STEERING_STEP_DEG=2
ROKI_MAPPING_STEERING_PULSE_SEC=0.2

# Friday demo is fixed-map Nav2. Diagnostic encoder fallback is fail-closed.
ROKI_NAVIGATION_MODE=nav2
# Backend route is fetched with the Robot service token on every START_PATROL.
AIOT_NAVIGATION_CONFIG_SOURCE=backend
# Local YAML is used only for a supervised Backend transport outage. HTTP/auth,
# schema, map identity/hash, occupancy and clearance failures always fail closed.
AIOT_NAVIGATION_LOCAL_FALLBACK_ENABLED=false
ROKI_ROUTE_FILE=/var/lib/aiot/config/route.local.yaml
# Backend navigation contract accepts 0.20..1.00 m. Keep this at or above
# ROKI_NAV2_XY_GOAL_TOLERANCE_M so Nav2 and mission completion agree.
ROKI_WAYPOINT_ACCEPTANCE_RADIUS_M=0.30
ROKI_ENCODER_FALLBACK_ENABLED=false
ROKI_ROUTE_START_X_M=1.0
ROKI_ROUTE_START_Y_M=2.5
ROKI_ROUTE_MAXIMUM_TRAVEL_M=0.70

# Required before curved Nav2 driving. Leave blank until physically measured.
ROKI_WHEELBASE_M=
ROKI_MAXIMUM_ROAD_WHEEL_ANGLE_DEG=
ROKI_MAXIMUM_LINEAR_SPEED_MPS=0.4
# CmdVelToEsp32Adapter 의 상한. 하한은 PATROL_DRIVE_SPEED_PWM(=45) 이므로
# 이 값이 45면 스팬이 0이 되어 어떤 cmd_vel 이 와도 항상 같은 PWM 이 나간다.
# 즉 Nav2 가 속도 제어권을 완전히 잃는다. 51 은 실측 구동점이다: PWM 50 에서
# 0.114 m/s 를 줄자로 검증했고(TF 오차 2.6%), 수동 주행도 51 로 동작한다.
# robot.yaml 의 speed_min(45) 이 하한을 다시 45 로 올리므로, 스팬은 반드시
# 45 '위'에 있어야 한다 -- 하한을 41 로 낮추는 방식은 그 바닥 보정에 먹힌다.
ROKI_MAXIMUM_DRIVE_PWM=51
ROKI_CMD_VEL_TOPIC=/cmd_vel
ROKI_NAVIGATE_ACTION=/navigate_to_pose
ROKI_MAP_FRAME=map
ROKI_SCAN_DWELL_SECONDS=3.0
ROKI_NAV2_XY_GOAL_TOLERANCE_M=0.20
ROKI_NAV2_CMD_VEL_TIMEOUT_SECONDS=3.0

# Field-verified safe defaults.
PATROL_DRIVE_SPEED_PWM=45
PATROL_STEERING_DEGREES=80

# Deprecated legacy subprocess path. Production uses aiot-ai.service + ROS.
PIPELINE_ENABLED=false
PIPELINE_SOURCE_A=/dev/roki_camera_front
PIPELINE_SOURCE_B=/dev/roki_camera_rear
PIPELINE_EXTRA_ARGS=--no-show
PIPELINE_START_GRACE_SECONDS=8

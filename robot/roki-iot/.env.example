# 로컬 설정 예시 (실비밀번호 넣지 말 것)
# 복사: cp .env.example .env

SCHEMA_VERSION=1
ROBOT_KEY=replace-with-backend-robot-key

MQTT_HOST=i15e103.p.ssafy.io
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=

POSE_PUBLISH_INTERVAL_SECONDS=1
STATUS_PUBLISH_INTERVAL_SECONDS=5

PIPELINE_SOURCE_A=/dev/roki_camera_front
PIPELINE_SOURCE_B=/dev/roki_camera_rear
PIPELINE_EXTRA_ARGS=--no-show
PIPELINE_START_GRACE_SECONDS=8
# 카메라 없는 하드웨어 시연은 false. AI readiness 통합 후 true로 전환한다.
PIPELINE_ENABLED=false

AIOT_AI_REQUIRED_FOR_PATROL=true
AIOT_LIDAR_REQUIRED_FOR_PATROL=true
OBSTACLE_CLEAR_HOLD_SECONDS=1.0
AIOT_BACKEND_BASE_URL=https://i15e103.p.ssafy.io
AIOT_BACKEND_TOKEN_FILE=/var/lib/aiot/secrets/robot-service-token
AIOT_COMMAND_CACHE_FILE=/var/lib/aiot/state/command-cache.json
AIOT_PATROL_DEPLOY_LOCK_FILE=/var/lib/aiot/state/patrol-deploy.lock
AIOT_DELETE_DELIVERED_EVIDENCE=true

# PWM 45 is the field-test baseline; 80 degrees is straight ahead.
PATROL_DRIVE_SPEED_PWM=45
ROKI_NAVIGATION_MODE=nav2
ROKI_ENCODER_FALLBACK_ENABLED=false
ROKI_ROUTE_FILE=/var/lib/aiot/config/route.local.yaml
ROKI_MAP_YAML=/var/lib/aiot/config/map.yaml
ROKI_MAP_ID=
ROKI_MAP_VERSION=
ROKI_MAP_SHA256=
ROKI_ROUTE_SHA256=
ROKI_MAP_MIN_KNOWN_COVERAGE_RATIO=0.10
ROKI_MAP_MIN_FREE_COVERAGE_RATIO=0.10
ROKI_ROBOT_RADIUS_M=
ROKI_INITIAL_POSE_X_M=
ROKI_INITIAL_POSE_Y_M=
ROKI_INITIAL_POSE_YAW_RAD=
ROKI_ROUTE_START_X_M=1.0
ROKI_ROUTE_START_Y_M=2.5
ROKI_ROUTE_MAXIMUM_TRAVEL_M=0.70
PATROL_STEERING_DEGREES=80

# Required only for curved Nav2 driving; keep blank until measured.
ROKI_WHEELBASE_M=
ROKI_MAXIMUM_ROAD_WHEEL_ANGLE_DEG=
ROKI_SCAN_DWELL_SECONDS=3.0
ROKI_NAV2_XY_GOAL_TOLERANCE_M=0.20
ROKI_NAV2_CMD_VEL_TIMEOUT_SECONDS=0.5

+void Explore::precheckGoal(const geometry_msgs::msg::PoseStamped& target_pose)
+{
+  planning_goal_ = true;
+  auto goal = nav2_msgs::action::ComputePathToPose::Goal();
+  goal.goal = target_pose;
+  goal.use_start = false;
+  goal.planner_id = frontier_planner_id_;
+  auto options = rclcpp_action::Client<nav2_msgs::action::ComputePathToPose>::SendGoalOptions();
+  options.goal_response_callback =
+      [this, target_pose](const PlanningGoalHandle::SharedPtr& handle) {
+        if (!handle) {
+          planning_goal_ = false;
+          recordGoalFailure(target_pose.pose.position, "planner_rejected");
+        }
+      };
+  options.result_callback =
+      [this, target_pose](const PlanningGoalHandle::WrappedResult& result) {
+        planning_goal_ = false;
+        if (!exploration_active_) {
+          return;
+        }
+        if (result.code != rclcpp_action::ResultCode::SUCCEEDED ||
+            !result.result || result.result->path.poses.empty()) {
+          recordGoalFailure(target_pose.pose.position, "path_unavailable");
+          makePlan();
+          return;
+        }
+        sendNavigationGoal(target_pose);
+      };
+  planner_client_->async_send_goal(goal, options);
+}


+void Explore::refreshFailuresFromMap(
+    const std::vector<frontier_exploration::Frontier>& frontiers)
+{
+  for (auto& failure : frontier_failures_) {
+    if (failure.attempts < frontier_max_attempts_ ||
+        failure.reactivations >= frontier_max_reactivations_) {
+      continue;
+    }
+    const auto frontier = std::find_if(
+        frontiers.begin(), frontiers.end(),
+        [this, &failure](const auto& candidate) {
+          return sameFrontier(failure.frontier_key, candidate);
+        });
+    if (frontier == frontiers.end() ||
+        frontier->local_free_cells <
+            failure.local_free_cells + frontier_reactivation_min_free_cells_) {
+      continue;
+    }
+    failure.attempts = frontier_max_attempts_ - 1;
+    failure.retry_after = this->now();
+    failure.frontier_key = frontier->centroid;
+    failure.local_free_cells = frontier->local_free_cells;
+    ++failure.reactivations;
+    RCLCPP_INFO(
+        logger_,
+        "Frontier reactivated after local FREE growth cluster=(%.3f, %.3f) "
+        "free_cells=%u reactivations=%u/%u",
+        frontier->centroid.x, frontier->centroid.y,
+        frontier->local_free_cells, failure.reactivations,
+        frontier_max_reactivations_);
+  }

+void Explore::publishStalled(const char* reason)
+{
+  RCLCPP_ERROR(
+      logger_, "MAPPING_DIAGNOSTIC event=EXPLORATION_STALLED reason=%s",
+      reason);
+  stop(false);
+  auto status_msg = explore_lite_msgs::msg::ExploreStatus();
+  status_msg.status = "exploration_stalled";
+  status_pub_->publish(status_msg);
+}

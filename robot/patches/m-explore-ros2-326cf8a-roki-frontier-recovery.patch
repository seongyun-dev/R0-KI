+bool Explore::goalOnCooldown(const geometry_msgs::msg::Point& goal)
+{
+  constexpr static size_t tolerance = 5;
+  const double radius = tolerance * costmap_client_.getCostmap()->getResolution();
+  for (auto& failure : frontier_failures_) {
+    if (fabs(goal.x - failure.goal.x) < radius &&
+        fabs(goal.y - failure.goal.y) < radius) {
+      return failure.attempts < frontier_max_attempts_ &&
+             this->now() < failure.retry_after;
+    }
+  }
+  return false;
+}
+
+void Explore::recordGoalFailure(const geometry_msgs::msg::Point& goal,
+                                const char* reason)
+{
+  constexpr static size_t tolerance = 5;
+  const double radius = tolerance * costmap_client_.getCostmap()->getResolution();
+  auto it = std::find_if(frontier_failures_.begin(), frontier_failures_.end(),
+      [&goal, radius](const FrontierFailure& failure) {
+        return fabs(goal.x - failure.goal.x) < radius &&
+               fabs(goal.y - failure.goal.y) < radius;
+      });
+  if (it == frontier_failures_.end()) {
+    frontier_failures_.push_back(
+        FrontierFailure{goal, 1, this->now() + rclcpp::Duration::from_seconds(frontier_retry_delay_)});
+    it = std::prev(frontier_failures_.end());
+  } else {
+    ++it->attempts;
+    it->retry_after = this->now() + rclcpp::Duration::from_seconds(frontier_retry_delay_);
+  }
+  RCLCPP_WARN(logger_, "Frontier goal failed reason=%s attempts=%u/%u target=(%.3f, %.3f)",
+              reason, it->attempts, frontier_max_attempts_, goal.x, goal.y);
+}

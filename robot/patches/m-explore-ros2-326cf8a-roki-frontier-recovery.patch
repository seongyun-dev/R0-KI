+void Explore::recordFrontierFailure(
+    const frontier_exploration::Frontier& frontier, const char* reason)
+{
+  auto it = std::find_if(
+      frontier_failures_.begin(), frontier_failures_.end(),
+      [this, &frontier](const FrontierFailure& failure) {
+        return sameFrontier(failure.frontier_key, frontier);
+      });
+  if (it == frontier_failures_.end()) {
+    frontier_failures_.push_back(FrontierFailure{
+        frontier.centroid, 1,
+        this->now() +
+            rclcpp::Duration::from_seconds(frontier_retry_delay_),
+        frontier.local_free_cells, 0});
+    it = std::prev(frontier_failures_.end());
+  } else {
+    ++it->attempts;
+    it->retry_after =
+        this->now() +
+        rclcpp::Duration::from_seconds(frontier_retry_delay_);
+    it->local_free_cells =
+        std::max(it->local_free_cells, frontier.local_free_cells);
+  }
+  const bool exhausted = it->attempts >= frontier_max_attempts_;
+  RCLCPP_WARN(
+      logger_,
+      "MAPPING_DIAGNOSTIC event=%s reason=%s attempts=%u/%u "
+      "cluster=(%.3f, %.3f) "
+      "approaches=%zu local_free_cells=%u",
+      exhausted ? "FRONTIER_RETRY_EXHAUSTED" : "NAVIGATION_FAILED",
+      reason, it->attempts, frontier_max_attempts_, frontier.centroid.x,
+      frontier.centroid.y, frontier.approaches.size(),
+      frontier.local_free_cells);
+}
+
+void Explore::clearFrontierFailure(
+    const frontier_exploration::Frontier& frontier)
+{
+  frontier_failures_.erase(
+      std::remove_if(
+          frontier_failures_.begin(), frontier_failures_.end(),
+          [this, &frontier](const FrontierFailure& failure) {
+            return sameFrontier(failure.frontier_key, frontier);
+          }),
+      frontier_failures_.end());
+}

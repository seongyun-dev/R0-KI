+void FrontierSearch::buildApproachCandidates(
+    Frontier& frontier, unsigned int reference,
+    const std::vector<unsigned int>& parent,
+    const std::vector<bool>& reachable)
+{
+  struct Candidate {
+    FrontierApproach approach;
+    double robot_distance;
+  };
+
+  unsigned int rx, ry;
+  double reference_x, reference_y;
+  costmap_->indexToCells(reference, rx, ry);
+  costmap_->mapToWorld(rx, ry, reference_x, reference_y);
+  const unsigned int retreat_cells = static_cast<unsigned int>(
+      std::ceil(approach_distance_ / costmap_->getResolution()));
+  const double spacing = std::max(candidate_spacing_, costmap_->getResolution());
+  std::vector<Candidate> candidates;
+
+  for (const auto& boundary : frontier.points) {
+    unsigned int bx, by;
+    if (!costmap_->worldToMap(boundary.x, boundary.y, bx, by)) {
+      continue;
+    }
+    const unsigned int boundary_index = costmap_->getIndex(bx, by);
+    unsigned int adjacent_free = boundary_index;
+    double best_robot_distance = std::numeric_limits<double>::infinity();
+    for (const unsigned int nbr : nhood8(boundary_index, *costmap_)) {
+      if (!reachable[nbr] || map_[nbr] != FREE_SPACE) {
+        continue;
+      }
+      unsigned int nx, ny;
+      double wx, wy;
+      costmap_->indexToCells(nbr, nx, ny);
+      costmap_->mapToWorld(nx, ny, wx, wy);
+      const double distance = std::hypot(wx - reference_x, wy - reference_y);
+      if (distance < best_robot_distance) {
+        adjacent_free = nbr;
+        best_robot_distance = distance;
+      }
+    }
+    if (adjacent_free == boundary_index) {
+      continue;
+    }
+
+    unsigned int approach_cell = adjacent_free;
+    for (unsigned int step = 0;
+         step < retreat_cells && parent[approach_cell] != approach_cell;
+         ++step) {
+      approach_cell = parent[approach_cell];
+    }
+    unsigned int ax, ay;
+    FrontierApproach approach;
+    costmap_->indexToCells(approach_cell, ax, ay);
+    costmap_->mapToWorld(
+        ax, ay, approach.position.x, approach.position.y);
+    approach.boundary = boundary;
+
+    const bool duplicate = std::any_of(
+        candidates.begin(), candidates.end(),
+        [&approach, spacing](const Candidate& existing) {
+          return std::hypot(
+                     existing.approach.position.x - approach.position.x,
+                     existing.approach.position.y - approach.position.y) < spacing;
+        });
+    if (!duplicate) {
+      candidates.push_back(Candidate{
+          approach,
+          std::hypot(approach.position.x - reference_x,
+                     approach.position.y - reference_y)});
+    }
+  }
+
+  if (candidates.empty()) {
+    return;
+  }
+  std::sort(candidates.begin(), candidates.end(),
+            [](const Candidate& one, const Candidate& two) {
+              return one.robot_distance < two.robot_distance;
+            });
+  frontier.approaches.push_back(candidates.front().approach);
+  std::vector<bool> selected(candidates.size(), false);
+  selected.front() = true;
+  while (frontier.approaches.size() < max_approaches_) {
+    size_t best_index = candidates.size();
+    double best_separation = spacing;
+    for (size_t i = 1; i < candidates.size(); ++i) {
+      if (selected[i]) {
+        continue;
+      }
+      double separation = std::numeric_limits<double>::infinity();
+      for (const auto& chosen : frontier.approaches) {
+        separation = std::min(
+            separation,
+            std::hypot(candidates[i].approach.position.x - chosen.position.x,
+                       candidates[i].approach.position.y - chosen.position.y));
+      }
+      if (separation > best_separation) {
+        best_separation = separation;
+        best_index = i;
+      }
+    }
+    if (best_index == candidates.size()) {
+      break;
+    }
+    selected[best_index] = true;
+    frontier.approaches.push_back(candidates[best_index].approach);
+  }
+  frontier.approach = frontier.approaches.front().position;
+}
+
+std::uint32_t FrontierSearch::countLocalFreeCells(
+    const geometry_msgs::msg::Point& center) const
+{
+  unsigned int cx, cy;
+  if (!costmap_->worldToMap(center.x, center.y, cx, cy)) {
+    return 0;
+  }
+  const int radius = static_cast<int>(
+      std::ceil(reactivation_radius_ / costmap_->getResolution()));
+  const double radius_squared =
+      reactivation_radius_ * reactivation_radius_;
+  std::uint32_t count = 0;
+  for (int dy = -radius; dy <= radius; ++dy) {
+    for (int dx = -radius; dx <= radius; ++dx) {
+      const int mx = static_cast<int>(cx) + dx;
+      const int my = static_cast<int>(cy) + dy;
+      if (mx < 0 || my < 0 || mx >= static_cast<int>(size_x_) ||
+          my >= static_cast<int>(size_y_)) {
+        continue;
+      }
+      const double world_dx = dx * costmap_->getResolution();
+      const double world_dy = dy * costmap_->getResolution();
+      if (world_dx * world_dx + world_dy * world_dy > radius_squared) {
+        continue;
+      }
+      if (map_[costmap_->getIndex(
+              static_cast<unsigned int>(mx),
+              static_cast<unsigned int>(my))] == FREE_SPACE) {
+        ++count;
+      }
+    }
+  }
+  return count;
+}
